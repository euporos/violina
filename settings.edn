{:merge-config "../settings.edn"
 :directus-url    "/directus/"
 :canonical-domain "new.violina-petrychenko.de"
 :site-name      "Macchiato Template"
 :google-site-verfication ""
 :print-sql false
 :host "0.0.0.0"
 :port 3000
 :locale-fallback [:de :en :uk :it] ; muss alle Sprachen enthalten
 :mode   :dev
 :share-with-frontend [:locale-fallback
                       :site-name
                       :directus-url
                       :mode
                       :noindex
                       :show-errors?
                       :email-to-b64]
 :noindex true
 :show-errors? true ;false
 :mail-on-errors? false
 :directus {:translations-key :translations
            :language-key :languages_code}

 ;; IP geolocation: defaults UI locale (only as a tiebreak after
 ;; Accept-Language) and the CD shipping region. Disabled in dev — flip
 ;; :enabled? on in the parent ../settings.edn or environment for prod.
 :geolocation {:enabled?               false
               :provider-url           "https://ipapi.co/%s/json/"
               :api-key                nil
               :trust-x-forwarded-for? false}

 :contact-email "info@example.com"
 :contact-phone "+49 000 0000000"

 ;; Required secrets — values come from ../settings.edn (parent, untracked).
 :admin-email     #psite/secret "admin-email"
 ;; :admin-password  #psite/secret "admin-password"
 :email-transporter {:host   "mx2ff9.netcup.net"
                     :port   465
                     :secure true
                     :auth   {:user #psite/secret "smtp-user"
                              :pass #psite/secret "smtp-pass"}}
 :db-config {:host    "localhost"
             :user    "directus"
             :port    5435
             :db-name "directus"
             :password #psite/secret "db-password"}}
