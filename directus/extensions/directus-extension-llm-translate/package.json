{
	"name": "directus-extension-llm-translate",
	"version": "1.0.0",
	"type": "module",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "endpoint",
				"name": "llm-translate",
				"source": "src/endpoint/index.js"
			},
			{
				"type": "interface",
				"name": "llm-translate-interface",
				"source": "src/interface/index.js"
			},
			{
				"type": "module",
				"name": "llm-translate-module",
				"source": "src/module/index.js"
			}
		],
		"host": "^11.0.0"
	},
	"scripts": {
		"build": "npx --package=@directus/extensions-sdk directus-extension build",
		"dev": "npx --package=@directus/extensions-sdk directus-extension build -w --no-minify"
	}
}
